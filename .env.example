# ============================================
# BASE URLS
# ============================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# MIDTRANS PAYMENT GATEWAY
# ============================================
# Sandbox: https://app.sandbox.midtrans.com/snap/snap.js
# Production: https://app.midtrans.com/snap/snap.js
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# ============================================
# GOOGLE MAPS
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAP_ID=your_google_map_id_here

# ============================================
# STORE LOCATION
# ============================================
NEXT_PUBLIC_STORE_LOCATION_ADDRESS="Jl. Example Street No. 123, City, Country"
NEXT_PUBLIC_STORE_LOCATION_LATITUDE=-6.200000
NEXT_PUBLIC_STORE_LOCATION_LONGITUDE=106.816666

# ============================================
# OPERATING HOURS (24h format: HH:mm)
# ============================================
NEXT_PUBLIC_OPENING_STORE="09:00"
NEXT_PUBLIC_CLOSING_STORE="22:00"
NEXT_PUBLIC_CLOSE_ORDER="21:30"

